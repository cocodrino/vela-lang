# Absolute path to piper binary
PIPER_BIN=

# Absolute path to voice model .onnx file
PIPER_MODEL=

# Optional path to model config .json
PIPER_CONFIG=

# Optional speaker id for multi-speaker models
PIPER_SPEAKER=

# Input mode: text | phoneme
PIPER_INPUT_MODE=text

# Optional default dictionary path
VELA_DICT_PATH=packages/vela-tts-piper/data/vela-dictionary.json

# Batch input/output
VELA_LIBRARY_INDEX=web-sample/public/content/index.json
VELA_LIBRARY_OUTPUT=packages/vela-tts-piper/output/library

# Sync destination for web sample audio
VELA_WEB_AUDIO_DIR=web-sample/public/audio
